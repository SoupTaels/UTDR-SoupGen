  "helpfile":"",
  "HTML5CodeInjection":"<GM_HTML5_PreBody>\r\n<!-- GX Style Injection -->\r\n<!-- By TabularElf -->\r\n<style>\r\n      html {\r\n        background: ${YYEXTOPT_HTML5Injection_GXStyleHTMLColour};\r\n      }\r\n\r\n      body {\r\n        background: ${YYEXTOPT_HTML5Injection_GXStyleBodyColour};\r\n      }\r\n\r\n      .spinner {\r\n        border: ${YYEXTOPT_HTML5Injection_GXStyleSpinnerBorder};\r\n        border-top: ${YYEXTOPT_HTML5Injection_GXStyleSpinnerBorderTop};\r\n        border-radius: ${YYEXTOPT_HTML5Injection_GXStyleSpinnerBorderRadius};\r\n\r\n        width: ${YYEXTOPT_HTML5Injection_GXStyleSpinnerWidth};\r\n        height: ${YYEXTOPT_HTML5Injection_GXStyleSpinnerHeight};\r\n\r\n        -webkit-animation: ${YYEXTOPT_HTML5Injection_GXStyleSpinnerAnimation};\r\n        -moz-animation: ${YYEXTOPT_HTML5Injection_GXStyleSpinnerAnimation};\r\n        -o-animation: ${YYEXTOPT_HTML5Injection_GXStyleSpinnerAnimation};\r\n         animation: ${YYEXTOPT_HTML5Injection_GXStyleSpinnerAnimation};\r\n\r\n         background-image: ${YYEXTOPT_HTML5Injection_GXStyleSpinnerBackgroundImage};\r\n         background-size: ${YYEXTOPT_HTML5Injection_GXStyleSpinnerBackgroundSize};\r\n         background-repeat: ${YYEXTOPT_HTML5Injection_GXStyleSpinnerBackgroundRepeat};\r\n         background-position: ${YYEXTOPT_HTML5Injection_GXStyleSpinnerBackgroundPosition};\r\n      }\r\n\r\n      progress[value]::-webkit-progress-value {\r\n        background-image: ${YYEXTOPT_HTML5Injection_GXStyleProgressBackgroundImage};\r\n        height: 10px;\r\n        border-radius: 15px;\r\n      }\r\n</style>\r\n\r\n<link rel=\"stylesheet\" href=\"${YYEXTOPT_HTML5Injection_GXStyleSheet}\">\r\n</GM_HTML5_PreBody>\r\n\r\n<GM_HTML5_BodyStart>\r\n    <script type=\"text/javascript\" src=\"${YYEXTOPT_HTML5Injection_GXStyleJSInjectionBodyStart}\"></script>\r\n</GM_HTML5_BodyStart>\r\n\r\n<GM_HTML5_BodyEnd>\r\n    <script type=\"text/javascript\" src=\"${YYEXTOPT_HTML5Injection_GXStyleJSInjectionBodyEnd}\"></script>\r\n</GM_HTML5_BodyEnd>",
  "html5Props":true,
